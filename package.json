    "hono": "^4.13.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.44.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.1.4",
